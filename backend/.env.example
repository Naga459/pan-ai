# Copy to backend/.env and adjust. Never commit the real .env file.

PAN_AI_ENVIRONMENT=development
PAN_AI_DEBUG=false

# PostgreSQL + pgvector (docker compose maps it to host port 6760)
PAN_AI_DATABASE_URL=postgresql+psycopg://pan_ai:pan_ai_dev@127.0.0.1:6760/pan_ai

# Comma-separated list of allowed browser origins
PAN_AI_CORS_ORIGINS=http://127.0.0.1:5760,http://localhost:5760

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) when PAN_AI_ENVIRONMENT=production
# PAN_AI_SECRET_KEY=

# Private storage for uploaded PAN documents (outside any web-served folder)
PAN_AI_STORAGE_DIR=./storage
PAN_AI_MAX_UPLOAD_MB=10
